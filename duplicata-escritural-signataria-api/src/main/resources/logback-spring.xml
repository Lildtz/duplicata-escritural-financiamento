<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <include resource="org/springframework/boot/logging/logback/structured-console-appender.xml"/>

    <!-- Hibernate emite códigos e mensagem do banco no mesmo nível; somente o resumo numérico é liberado. -->
    <appender name="JDBC_SEGURO" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>br.com.duplicataescritural.signataria.observabilidade.DiagnosticoJdbcSeguro</format>
        </encoder>
    </appender>
    <logger name="org.hibernate.orm.jdbc.error" level="WARN" additivity="false">
        <appender-ref ref="JDBC_SEGURO"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>

    {
      "id": 13,
      "type": "timeseries",
      "title": "p95 consulta bem-sucedida — referência 2s",
      "description": "Histogramas agregados por job/operação. Exige pelo menos 20 amostras em 15min; abaixo disso fica Sem dados. Aproximação por buckets, sem quantil fictício ou extrapolação de uma amostra.",
      "datasource": {
        "type": "prometheus",
        "uid": "duplicata-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "duplicata-prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by(job,operacao,le) (rate({__name__=~\"financiamento_registradora_operacao_seconds_bucket|signataria_operacao_seconds_bucket\",job=~\"banco-dup|signataria\",operacao=\"consultar_duplicatas\",resultado=\"sucesso\"}[15m]))) and on(job,operacao) (sum by(job,operacao) (increase({__name__=~\"financiamento_registradora_operacao_seconds_count|signataria_operacao_seconds_count\",job=~\"banco-dup|signataria\",operacao=\"consultar_duplicatas\",resultado=\"sucesso\"}[15m])) >= 20)",
          "legendFormat": "{{job}} {{operacao}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": false,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",

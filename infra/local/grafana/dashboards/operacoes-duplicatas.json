    {
      "id": 12,
      "type": "timeseries",
      "title": "Sucesso técnico — 15min; referência 99%",
      "description": "1 - falhas técnicas/chamadas, por camada. Rejeições classificadas não técnicas contam como resposta técnica. Filtros de autenticação anteriores ao serviço não entram. Sem tráfego não há percentual.",
      "datasource": {
        "type": "prometheus",
        "uid": "duplicata-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "duplicata-prometheus"
          },
          "editorMode": "code",
          "expr": "(100 * (1 - ((sum by(job) (increase({__name__=~\"financiamento_registradora_operacao_seconds_count|signataria_operacao_seconds_count\",job=~\"banco-dup|signataria\",resultado=\"falha\"}[15m]) or increase({__name__=~\"financiamento_registradora_operacao_seconds_count|signataria_operacao_seconds_count\",job=~\"banco-dup|signataria\",motivo=\"AUTENTICACAO_REJEITADA\"}[15m])) or on(job) (0 * sum by(job) (increase({__name__=~\"financiamento_registradora_operacao_seconds_count|signataria_operacao_seconds_count\",job=~\"banco-dup|signataria\"}[15m])))) / sum by(job) (increase({__name__=~\"financiamento_registradora_operacao_seconds_count|signataria_operacao_seconds_count\",job=~\"banco-dup|signataria\"}[15m]))))) and on(job) (sum by(job) (increase({__name__=~\"financiamento_registradora_operacao_seconds_count|signataria_operacao_seconds_count\",job=~\"banco-dup|signataria\"}[15m])) > 0)",
          "legendFormat": "{{job}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"
          },

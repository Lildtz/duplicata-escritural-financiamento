    {
      "id": 9,
      "type": "timeseries",
      "title": "Latência média das operações",
      "description": "Timers semânticos por camada/operação; não somar as duas camadas como uma única chamada.",
      "datasource": {
        "type": "prometheus",
        "uid": "duplicata-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 22,
        "w": 12,
        "h": 7

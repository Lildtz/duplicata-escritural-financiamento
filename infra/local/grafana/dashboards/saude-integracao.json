      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "duplicata-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(job,operacao) (rate({__name__=~\"financiamento_registradora_operacao_seconds_sum|signataria_operacao_seconds_sum\",job=~\"banco-dup|signataria\"}[5m])) / (sum by(job,operacao) (rate({__name__=~\"financiamento_registradora_operacao_seconds_count|signataria_operacao_seconds_count\",job=~\"banco-dup|signataria\"}[5m])) > 0)",
          "legendFormat": "{{job}} {{operacao}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados",

          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latência HTTP média",
      "description": "Média ponderada por requisição. Timers HTTP não recebem histogramas; não é p95.",
      "datasource": {
        "type": "prometheus",
        "uid": "duplicata-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "duplicata-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(job) (rate(http_server_requests_seconds_sum{job=~\"banco-dup|signataria\"}[5m])) / (sum by(job) (rate(http_server_requests_seconds_count{job=~\"banco-dup|signataria\"}[5m])) > 0)",
          "legendFormat": "{{job}} servidor",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "duplicata-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(job) (rate(http_client_requests_seconds_sum{job=\"banco-dup\"}[5m])) / (sum by(job) (rate(http_client_requests_seconds_count{job=\"banco-dup\"}[5m])) > 0)",
          "legendFormat": "{{job}} cliente",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "Sem dados",
          "color": {
            "mode": "palette-classic"

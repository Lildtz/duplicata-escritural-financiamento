        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Erros HTTP servidor — categoria e rota",
      "description": "CLIENT_ERROR inclui autenticação, autorização e requisições inválidas; não classificar todo 4xx como falha técnica ou rejeição financeira.",
      "datasource": {
        "type": "prometheus",
        "uid": "duplicata-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 15,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "duplicata-prometheus"
          },
          "editorMode": "code",
          "expr": "sum by(job,outcome,uri) (rate(http_server_requests_seconds_count{job=~\"banco-dup|signataria\",status=~\"[45]..\"}[5m]))",
          "legendFormat": "{{job}} {{outcome}} {{uri}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "Sem dados",
